# Copy to wrangler.toml and fill the placeholders. wrangler.toml is git-ignored.
name = "pult"
main = "src/index.ts"
compatibility_date = "2026-08-01"

# Hourly tick: expire undecided cards, wake snoozed ones, retry a render that failed.
[triggers]
crons = ["0 * * * *"]

[[d1_databases]]
binding = "DB"
database_name = "pult"
database_id = "<D1_DATABASE_ID>"       # `npx wrangler d1 create pult` prints it

[vars]
CHAT_ID = "<YOUR_TELEGRAM_USER_ID>"    # the only person the bot answers; your id, from @userinfobot or the first webhook update
OWNER_TZ = "UTC"                       # IANA zone, e.g. "Europe/Berlin": "tomorrow" means 08:00 there

# Secrets, set with `npx wrangler secret put <NAME>` (never in this file):
#   TELEGRAM_BOT_TOKEN   from BotFather
#   TG_SECRET            a long random string; /setup registers it as the webhook's secret_token
#   RUN_KEY              a long random string; the Mac side sends it as `Authorization: Bearer <key>`
#   RUNNER_KEY           optional second key that opens only the queue routes (events, sessions, files, pause)
