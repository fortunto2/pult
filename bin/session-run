#!/usr/bin/env python3
"""Shim: runs pult.session_run from this checkout when the package is not installed."""
import sys
from pathlib import Path

try:
    import pult  # noqa: F401
except ImportError:
    sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))
from pult.session_run import cli

cli()
