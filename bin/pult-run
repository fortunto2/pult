#!/usr/bin/env python3
"""The consumer of the queue: pulls events from the worker over HTTPS and hands each to bin/session-run.

    pult-run                  both slots, forever (run it under launchd with KeepAlive)
    pult-run --once           pull at most one event per slot, run it, exit (tests, hand runs)
    pult-run --slot interactive|background

Two slots: `interactive` takes the owner's messages and button presses; `background` takes only low-priority jobs (events you
queue yourself), and the worker does not hand it one while a message of the owner waits. While `limit-until` (written when the
Claude usage limit is hit) is in the future nothing is pulled. One instance per state dir (flock).
Env: PULT_URL, PULT_RUNNER_KEY_FILE, PULT_STATE, PULT_RUNNER (argv prefix, JSON), PULT_POLL_S, PULT_LOG.
"""
import argparse
import fcntl
import json
import os
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import pult_config as cfg  # noqa: E402

BIN = cfg.BIN
RUNNER = json.loads(os.environ.get("PULT_RUNNER", json.dumps([sys.executable, str(BIN / "session-run"), "-"])))
POLL_S = float(os.environ.get("PULT_POLL_S", "3"))
STATE = cfg.state_dir()


def log_file() -> Path:
    return Path(os.environ.get("PULT_LOG") or cfg.WORK / "pult.log")


def log(msg: str) -> None:
    try:
        f = log_file()
        f.parent.mkdir(parents=True, exist_ok=True)
        with f.open("a") as fh:
            fh.write(f"{time.strftime('%F %T')} [pult-run] {msg}\n")
    except OSError:
        pass


def post(path: str, body: dict) -> dict:
    req = urllib.request.Request(f"{cfg.url()}{path}", data=json.dumps(body).encode(), method="POST", headers={
        "Authorization": f"Bearer {cfg.runner_key_file().read_text().strip()}", "Content-Type": "application/json", "User-Agent": cfg.UA})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.load(r)


def paused() -> bool:
    try:
        return time.time() < float((cfg.state_dir() / "limit-until").read_text().strip() or 0)
    except (OSError, ValueError):
        return False


def run_event(ev: dict) -> int:
    log(f"event {ev['id']} P{ev['priority']} session {ev.get('session_id')} start")
    # only the owner's events are run; session-run refuses anything else again on its own
    p = subprocess.run(RUNNER, input=json.dumps(ev), text=True, capture_output=True)
    if p.returncode:
        log(f"event {ev['id']} rc={p.returncode} {(p.stderr or p.stdout).strip()[-200:]}")
    else:
        log(f"event {ev['id']} ok")
    return p.returncode


def step(slot: str) -> bool:
    """One pull; True when an event was run."""
    if paused():
        return False
    ev = post("/events/pull", {"slot": slot}).get("event")
    if not ev:
        return False
    run_event(ev)
    return True


class Outage:
    """Network errors are a quiet retry: one log line when an outage starts, one when it ends, backoff 15 s doubling to 120 s."""

    def __init__(self, slot: str):
        self.slot, self.tries, self.since = slot, 0, 0.0

    def failed(self, e: Exception) -> float:
        if not self.tries:
            self.since = time.time()
            log(f"{self.slot}: network error, retrying quietly: {e}")
        self.tries += 1
        return min(15 * 2 ** (self.tries - 1), 120)

    def ok(self) -> None:
        if self.tries:
            log(f"{self.slot}: network back after {int(time.time() - self.since)}s, {self.tries} tries")
            self.tries = 0


def loop(slot: str, once: bool) -> None:
    out = Outage(slot)
    while True:
        try:
            ran = step(slot)
            out.ok()
        except (OSError, urllib.error.URLError, ValueError) as e:
            wait = out.failed(e)
            ran = False
            if once:
                log(f"{slot}: {e}")
            time.sleep(wait)
        if once:
            return
        if not ran:
            time.sleep(POLL_S)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--once", action="store_true")
    ap.add_argument("--slot", choices=["interactive", "background", "both"], default="both")
    a = ap.parse_args()
    STATE.mkdir(parents=True, exist_ok=True)
    lock = (STATE / "pult-run.lock").open("w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("pult-run already running", file=sys.stderr)
        return 0
    slots = ["interactive", "background"] if a.slot == "both" else [a.slot]
    threads = [threading.Thread(target=loop, args=(s, a.once), daemon=False) for s in slots]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    return 0


if __name__ == "__main__":
    sys.exit(main())
